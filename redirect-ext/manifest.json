{
  "manifest_version": 3,
  "name": "URL Redirect Pro",
  "description": "Automatic URL Redirect, Path Rewriter & Proactive Error Resolver for localhost:4502",
  "version": "1.7.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Redirect Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.json", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}

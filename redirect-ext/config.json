{
  "rules": [
    {
      "id": "localhost-https-to-http",
      "description": "Redirect https://localhost:4502/* → http://localhost:4502/*",
      "enabled": true,
      "matchType": "prefix",
      "from": "https://localhost:4502/",
      "to": "http://localhost:4502/"
    },
    {
      "id": "localhost-4503-https-to-http",
      "description": "Redirect https://localhost:4503/* → http://localhost:4503/*",
      "enabled": false,
      "matchType": "prefix",
      "from": "https://localhost:4503/",
      "to": "http://localhost:4503/"
    }
  ],

  "aemAuthorRewrite": {
    "enabled": true,
    "description": "Automatically rewrite live-site or nested URLs pasted into localhost to local AEM Author path (/content/sitename/...)",
    "localhostBase": "http://localhost:4502",
    "defaultSiteName": "mysite",
    "prependEditorHtml": false,
    "liveDomains": [
      "https://live-site.com",
      "https://www.example.com"
    ]
  },

  "htmlFallback": {
    "enabled": true,
    "description": "Proactively resolve page errors (404, 403, 500, network errors): strip trailing slash, append .html, prepend path prefixes",
    "matchPatterns": [
      "http://localhost:4502/*",
      "http://localhost:4503/*"
    ],
    "pathPrefixes": [
      "/content/mysite"
    ],
    "skipIfPathEndsWith": [
      ".js", ".css", ".json", ".xml",
      ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".ico",
      ".woff", ".woff2", ".ttf", ".eot",
      ".pdf", ".zip", ".map"
    ]
  }
}

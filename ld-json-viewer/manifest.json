{
  "manifest_version": 3,
  "name": "LD+JSON Schema Viewer",
  "version": "1.1.0",
  "description": "Extracts and visualizes application/ld+json schema from the current webpage elegantly.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "View LD+JSON Schema"
  }
}
